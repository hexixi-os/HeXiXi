[build]
target = "riscv64gc-unknown-none-elf"

[target.riscv64gc-unknown-none-elf]
rustflags = [
    "-Clink-arg=-Tsrc/linker.ld", "-Cforce-frame-pointers=yes"
]

[target.loongarch64-unknown-none-softfloat]
rustflags = [
    "-Clink-arg=-Tsrc/arch/loongarch64/linker.ld", "-Cforce-frame-pointers=yes"
]
